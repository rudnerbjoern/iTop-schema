# Normalize detected text files to LF across platforms; preserve binary contents.
* text=auto eol=lf

# Schema sources, fixtures, documentation, and configuration.
*.xsd text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.svg text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf

# Python, PowerShell, and shell scripts use LF, including on Windows.
*.py text eol=lf
*.ps1 text eol=lf
*.psm1 text eol=lf
*.psd1 text eol=lf
*.sh text eol=lf

# Windows command scripts require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Common binary documents, images, and archives must remain byte-for-byte intact.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.7z binary
